{
    /* * 🌌 L€yzS Ricing - Waybar Configuration 🌌
     * 🛠️  Architected by L€yzS
     * 🖥️  Output: DP-1 | Setup: Floating Top Bar
     */

    "reload_config_on_change": false,
    "reload_style_on_change": true,
    "layer": "top",
    "output": "eDP-1",
    "position": "top",
    "height": 38,
    "margin-top": 0,
    "margin-left": 50,
    "margin-right": 50,
    "spacing": 10,
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    /* [TR] Modül Dizilimleri / [EN] Module Layouts */
    "modules-left": ["clock", "pulseaudio", "custom/media"],    
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [
        "tray", 
        "cpu", 
        "memory", 
        "custom/separator", 
        "custom/power"
    ],

    /* [TR] Saat ve Tarih / [EN] Clock & Date */
    "clock": {
        "format": " {:%H:%M:%S}",
        "interval": 1,
	"timezone": "Europe/Kyiv"
    },

    /* [TR] Ses Kontrolü / [EN] Audio Control */
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },

    /* [TR] Çalışma Alanları / [EN] Workspaces */
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "1": [], "2": [], "3": [], "4": []
        }
    },

    /* [TR] Sistem Tepsisi / [EN] System Tray */
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    /* [TR] İşlemci Kullanımı / [EN] CPU Usage */
    "cpu": {
        "interval": 1,
        "format": " {usage}%",
        "on-click": "tilix -e btop"
    },

    /* [TR] Bellek Kullanımı / [EN] Memory Usage */
    "memory": {
        "interval": 1, 
        "format": "  {used:0.1f}G/{total:0.1f}G", 
        "on-click": "kitty btop"
    },

    /* [TR] Ayırıcı Çizgi / [EN] Visual Separator */
    "custom/separator": { "format": "|" },

    /* [TR] Güç Menüsü (Wlogout) / [EN] Power Menu (Wlogout) */
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 5 -c 0 -p layer-shell",
        "tooltip": false
    },

    /* [TR] Medya Oynatıcı Kontrolü / [EN] Media Player Control */
    "custom/media": {
        "format": "<span color='#1DB954'></span>  {}", 
        "max-length": 40,
        "interval": 1,
        "exec": "~/.config/waybar/scripts/media.sh",
        "on-click": "playerctl play-pause",
	"on-click-right": "~/.config/waybar/scripts/media-toggle.sh",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    }
}
